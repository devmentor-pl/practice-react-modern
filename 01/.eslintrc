{
  "parser": "@babel/eslint-parser",
  "extends": ["airbnb", "prettier"],

  "parserOptions": {
    "requireConfigFile": false,
    "ecmaVersion": 2021,
    "sourceType": "module"
  },

  "rules": {
    "react/jsx-filename-extension": [1, {
      "extensions": [".js"]
    }]
  },

  "globals": {
    "window": true,
    "document": true
  }
}